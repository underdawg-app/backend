NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/underdwag

CORS_ORIGIN=*

# ----- Cloudinary (media upload) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- OTP (phone auth) -----
OTP_TTL_SECONDS=300
# When true, the OTP code is printed to the server log instead of being sent via SMS.
OTP_DEV_PRINT=true

# ----- Google OAuth (Sign in with Google) -----
# WEB OAuth client ID from Google Cloud Console (Google Auth platform → Clients).
# Same value the mobile app uses as webClientId; the ID token is verified against it.
GOOGLE_CLIENT_ID=

# ----- Firebase (realtime chat bridge) -----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key with literal \n escapes; it is unescaped at runtime.
FIREBASE_PRIVATE_KEY=
FIREBASE_DB_URL=

# ----- MSG91 (frontend-driven OTP; backend verifies — later phase) -----
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
